<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.roldos"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="30" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- "Close everything": lets us end other apps' background (cached) processes. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- "Close all apps" fully: RoldOS talks to the projector's own debug service on
         127.0.0.1:5555 to force-stop apps (LocalAdb). Local connection only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Re-enable our Home-key service when the projector's stock settings menu wipes the
         accessibility list. Development permission: granted once with
         `adb shell pm grant com.roldos android.permission.WRITE_SECURE_SETTINGS`. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Top-bar Wi-Fi status. Android only reveals the network's name to apps holding the
         location permission; granted once over adb by build.sh (no on-screen prompt).
         CHANGE_WIFI_STATE lets RoldOS ask for a scan to reconnect faster after a drop. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Android 11+ package visibility: we need to see every launchable app. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.htc.luminaos" />
        <package android:name="com.softwinner.awlivetv" />
        <package android:name="com.softwinner.miracastReceiver" />
        <package android:name="com.toofifi.lineserver" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Catches the remote's Home key on devices that hard-wire it to the stock launcher. -->
        <service
            android:name=".HomeKeyService"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key" />
        </service>

        <!-- "Now playing" row: Android shows other apps' media sessions only to approved
             notification listeners. Empty service, reads no notifications; approved by
             build.sh with `cmd notification allow_listener`. -->
        <service
            android:name=".MediaAccess"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
